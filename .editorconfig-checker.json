{
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": false,
  "Exclude": [
    "\\.php$",
    "^node_modules/",
    "^vendor/",
    "^web/vendor/",
    "^resources/public/assets/",
    "^web/public/dist/",
    "^tests/\\.phpunit\\.result\\.cache$",
    "^\\.php-cs-fixer\\.cache$",
    "\\.idea/",
    "docs/",
    "LICENSE",
    "Makefile$",
    "\\.rst$",
    "var/"
  ],
  "AllowedContentTypes": [],
  "PassedFiles": [],
  "Disable": {
    "EndOfLine": false,
    "Indentation": false,
    "InsertFinalNewline": false,
    "TrimTrailingWhitespace": false,
    "IndentSize": false,
    "MaxLineLength": false
  }
}
